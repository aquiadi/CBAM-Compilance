        {
          "item": "HSD",
          "category": "fuel",
          "quantity": 24.5,
          "unit": "KL"
        },
        {
          "item": "LSHS",
          "category": "fuel",
          "quantity": 61.32,
          "unit": "MT"
        }
      ]
