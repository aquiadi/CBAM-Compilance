# CarbonPass AI reads this at request time on the server only.
# Without it the app still runs end to end: every AI step falls back to its
# deterministic heuristic (see src/lib/ai/) and the UI labels the provenance of
# each inference as "heuristic" rather than "model".
#
# The LLM layer is built on the @anthropic-ai/sdk client, which reads this
# variable by convention.
ANTHROPIC_API_KEY=

# Model used for column mapping, anomaly triage and the assurance memo.
CARBONPASS_MODEL=claude-opus-5
