# CarbonPass - runtime configuration.
#
# Every variable is optional for local use: `npm run dev` with none of these set
# runs the whole product on an embedded database under ./.data. Values are
# validated at startup in src/config/env.ts; a bad one stops the process with
# the variable named.

# --- Storage ---------------------------------------------------------------

# Postgres connection string. Required on Vercel (add Neon under Storage and it
# is set for you; POSTGRES_URL is accepted as an alias). On Railway, reference
# the Postgres plugin's DATABASE_URL. When unset, an embedded Postgres (PGlite)
# keeps its files under CARBONPASS_DATA_DIR.
DATABASE_URL=

# Where the embedded database lives when DATABASE_URL is unset. In the container
# image this is /app/.data - mount a volume there to keep your data.
CARBONPASS_DATA_DIR=.data

# --- Access ----------------------------------------------------------------

# "open": anyone can create an account and an organisation.
# "invite": accounts can only be created from an invitation link. Create your own
# account first, then switch to invite.
CARBONPASS_SIGNUP=open

# Public base URL, used in invitation and supplier-portal links and to decide
# whether cookies are marked Secure. Derived from the request when unset.
APP_URL=

# Largest accepted upload in MB. Vercel caps request bodies at about 4.5 MB.
CARBONPASS_MAX_UPLOAD_MB=4

# --- Model (optional) --------------------------------------------------------

# Enables reading bills, receipts and photos (PDF, JPEG, PNG, WebP): the model
# proposes each figure with the text it read it from, and a person checks
# every line before it becomes a draft dataset. Without a key, documents are
# stored and figures are typed in, and every other AI step (column mapping,
# finding triage, methodology memo) uses its deterministic implementation.
ANTHROPIC_API_KEY=
CARBONPASS_MODEL=claude-opus-5

# The free option: a Groq API key (console.groq.com, free tier, no card).
# Used when ANTHROPIC_API_KEY is unset. Groq runs open-weight models: PDFs are
# read from their text layer (scanned PDFs need to be uploaded as photos),
# photos go to a vision model, and free-tier rate limits apply.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Mail (optional) ---------------------------------------------------------

# SMTP connection for sending invitations, supplier requests and password
# resets, e.g. smtps://user:password@smtp.example.com:465. Without it, links
# are shown to copy and send yourself, and owners issue password-reset links.
SMTP_URL=
# Sender address, e.g. CarbonPass <cbam@yourplant.in>. Mail is only sent when
# both SMTP_URL and MAIL_FROM are set.
MAIL_FROM=

# --- Assumptions -------------------------------------------------------------

# EUR per certificate for quarters the Commission has not yet published (the
# published 2026 prices are built in). Each workspace can override it.
CARBONPASS_ETS_PRICE_EUR=75

# INR per EUR, for showing the cost in rupees.
CARBONPASS_INR_PER_EUR=92
